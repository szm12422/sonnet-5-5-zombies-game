{
  "name": "dead-signal-exclusion-zone",
  "private": true,
  "version": "1.0.0",
  "description": "DEAD SIGNAL: EXCLUSION ZONE - Discord Activity-ready single-player extraction-survival FPS built with Three.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szm12422/sonnet-5-5-zombies-game.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:weapons": "node scripts/fetch-weapon-assets.mjs",
    "build": "npm run assets:weapons && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "activity:check": "node scripts/activity-check.mjs",
    "activity:build": "npm run build && npm run activity:check"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/three": "0.186.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
